# ==========================================
# Database Connection (Neon Serverless PostgreSQL)
# ==========================================
# Dapatkan connection string dari dashboard Neon (https://console.neon.tech)
# Pastikan menggunakan format postgresql://... dengan sslmode=require
# Jika dikosongkan pada mode pengembangan lokal, sistem otomatis menggunakan
# fallback database file lokal di /data/wedding-db.json
DATABASE_URL="postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ==========================================
# Admin Authentication & Security
# ==========================================
# Username dan password untuk mengakses /admin/dashboard
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="dian-iqbal-2027"

# Kunci rahasia untuk menandatangani token sesi cookie HTTP-Only
# Gunakan string acak minimal 32 karakter pada deployment produksi
SESSION_SECRET="session_token_dian_iqbal_luxury_2027_change_this_in_production"

# ==========================================
# Node Environment
# ==========================================
NODE_ENV="development"
